{
  "projects": [
    {
      "cwd": ".",
      "kind": "go",
      "version": "1.27.0",
      "commands": [
        [
          "go",
          "test",
          "./..."
        ]
      ],
      "local_env": {
        "DRIVER": "sqlite",
        "SKIP_CONTAINER_TESTS": "1"
      }
    },
    {
      "cwd": "web",
      "kind": "node",
      "version": "24",
      "manager": "pnpm@11.0.1",
      "commands": [
        [
          "pnpm",
          "install",
          "--frozen-lockfile"
        ],
        [
          "pnpm",
          "run",
          "lint"
        ],
        [
          "pnpm",
          "run",
          "test"
        ],
        [
          "pnpm",
          "run",
          "build"
        ]
      ]
    }
  ],
  "tools": [
    "go",
    "node",
    "pnpm",
    "python3"
  ],
  "ci_requires_docker": true
}
